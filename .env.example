# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Supabase
# (Settings > API no painel do Supabase). Sem essas variáveis, o app funciona
# normalmente em modo local (localStorage), mas o ranking da turma mostra
# apenas dados de exemplo.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
